{
  "name": "sidebar-notes",
  "id": "sidebar-notes@chung1905.github.io",
  "description": "Displays a sidebar that lets you take notes on web pages.",
  "version": "4.4.0",
  "author": "chung1905",
  "bugs": {
    "url": "https://github.com/chung1905/firefox-notes/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "ckeditor5": "^48.4.0",
    "preact": "^10.29.8",
    "react": "^19.2.8",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "pontoon-to-webext": "^1.0.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass": "^1.103.1",
    "selenium-webdriver": "^4.47.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "vite": "^8.2.2",
    "web-ext": "^10.6.0"
  },
  "homepage": "https://github.com/chung1905/firefox-notes#readme",
  "license": "MPL-2.0",
  "repository": "chung1905/firefox-notes",
  "scripts": {
    "build": "node scripts/build-locales && npm run vite && web-ext build -s build",
    "clean": "rimraf web-ext-artifacts && npm run postinstall",
    "format": "prettier 'src/**/*.{scss,css,js,jsx}' --single-quote --write",
    "lint": "npm-run-all lint:*",
    "lint:css": "stylelint 'src/**/*.{scss,css}'",
    "lint:js": "eslint src",
    "package": "npm run build && mv web-ext-artifacts/*.zip addon.xpi",
    "postformat": "npm run lint:js -- --fix",
    "postinstall": "node scripts/build-locales.js",
    "prebuild": "npm run clean",
    "start": "npm run vite && web-ext run -s build & npm run vite:watch",
    "start-rtl": "WEB_EXT_PREF=general.useragent.locale=ar npm start",
    "start-nightly": "npm run vite && web-ext run -s build --firefox=nightly & npm run vite:watch",
    "start-deved": "npm run vite && web-ext run -s build --firefox=firefoxdeveloperedition & npm run vite:watch",
    "test": "npm-run-all test:*",
    "test:ui": "test/integration/setup-webext.sh && mocha ./test/integration --recursive --extension mjs --retries 1 --reporter=list",
    "vite": "vite build",
    "vite:watch": "vite build --mode development --watch"
  }
}
